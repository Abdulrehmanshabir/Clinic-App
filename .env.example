# Supabase Public Configuration (Required on frontend and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Used ONLY in secure server actions/routes, NEVER exposed to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Clinic Metadata Defaults
NEXT_PUBLIC_CLINIC_NAME="Lumière Skin & Aesthetic Clinic"
NEXT_PUBLIC_CLINIC_TAGLINE="Advanced Dermatology & Aesthetic Care"
